            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AddMedicationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".HealthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".FoodActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".WorkoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DMActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ProfileQuestionsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SuggestedDishes"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MorningPills"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MedicationsActivity"
